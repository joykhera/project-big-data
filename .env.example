# Anthropic Claude API key — used by paper_tool/opportunities.py to generate
# distinct, paper-specific business opportunities. If unset, the app falls back
# to template-based opportunities (works, but lower quality).
ANTHROPIC_API_KEY=

# Optional: override the default Claude model.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Congress.gov API key — required by policy/ingestion/congress.py.
# Get one at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
